{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "environment",
    "level",
    "message"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "level": {
      "enum": [
        "INFO",
        "WARN",
        "ERROR"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
